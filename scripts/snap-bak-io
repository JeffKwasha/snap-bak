#!/usr/bin/env python3
"""
snap-bak-io: root-owned privileged helper for snap-bak.

The only command snap-bak may run via sudo (NOPASSWD). It derives every
path from the ROOT-OWNED config file, so the unprivileged service user can
never pass arbitrary paths to btrfs/mount. Accepted operations:

  snap-bak-io snapshot      <job> <name> -> btrfs subvolume snapshot -r
  snap-bak-io delete       <job> <name> -> btrfs subvolume delete
  snap-bak-io mount        <job> <name> -> mkdir + mount -o bind,ro
  snap-bak-io umount       <job>        -> umount -l
  snap-bak-io update-restic             -> validate + self-update + setcap

  Mount points live at <mount_base>/<source_subvolume final component>
  (e.g. /mnt/data -> /mnt/bak/data), always derived from the source
  subvolume's last path component — never configurable. Snapshots are bound
  read-only; btrfs has no uid/gid mount options, and restic reads root-owned
  files via cap_dac_read_search on the restic binary (applied by
  'update-restic').

This wrapper is intentionally standalone: it must NOT import scripts.snap_bak
(the security boundary is the wrapper itself; coupling to the orchestrator
would let a bug there widen this path). It is installed root:root 0755 by
snap-bak-setup.sh.

The sudoers rule `snap-bak ALL=(root) NOPASSWD:/opt/snap-bak/snap-bak-io`
is valid on both sudo-rs and sudo.ws: a bare command name matches any
arguments (see sudoers(5)), and '*' is deliberately avoided because sudo-rs
mishandles it.

Config is JSONC (// and /* */ comments allowed); json5 is used to parse it.
The orchestrator (snap_bak.py) parses the same config with the same library,
so the JSONC handling lives in exactly one place.
"""
import json5
import os
import re
import stat
import subprocess
import sys

CONFIG_PATH = "/opt/snap-bak/config.json"
SNAPSHOT_RE = re.compile(r"^\d{4}-\d{2}-\d{2}_\d{2}:\d{2}$")

BTRFS = "/usr/bin/btrfs"
MOUNT = "/usr/bin/mount"
UMOUNT = "/usr/bin/umount"
RESTIC = "/usr/local/bin/restic"
SETCAP = "/usr/sbin/setcap"


def _exit_err(msg: str, code: int = 1) -> "NoReturn":
    print(f"snap-bak-io: {msg}", file=sys.stderr)
    sys.exit(code)


def load_config() -> dict:
    try:
        with open(CONFIG_PATH) as f:
            return json5.loads(f.read())
    except OSError as e:
        _exit_err(f"cannot read {CONFIG_PATH}: {e}")
    except Exception as e:
        _exit_err(f"invalid JSON in {CONFIG_PATH}: {e}")


def _find_job(config: dict, job_name: str) -> dict:
    for job in config.get("jobs", []):
        if job.get("name") == job_name:
            return job
    _exit_err(f"unknown job: {job_name}")
    raise SystemExit(1)  # unreachable


def _validate_name(name: str) -> str:
    if not SNAPSHOT_RE.match(name):
        _exit_err(f"invalid snapshot name: {name!r} (expected YYYY-MM-DD_HH:MM)")
    return name


def _mount_base(config: dict) -> str:
    return config.get("mount_base", "/bak")


def _job_mount_point(config: dict, job: dict) -> str:
    """Mount point for a job: <mount_base>/<source_subvolume final component>.

    Always the last path component of 'source_subvolume' (e.g. /mnt/data
    -> data, 'home' -> home); never configurable. Mirrors the real
    filesystem path so the mount point is stable across backups (restic
    change-tracking keys on it) and is independent of the job's display name.
    """
    return os.path.join(_mount_base(config), os.path.basename(job["source_subvolume"].rstrip("/")))


def _job_path(job: dict, name: str) -> str:
    """snapshot_dir/name, rejecting any traversal beyond snapshot_dir."""
    base = os.path.realpath(job["snapshot_dir"])
    target = os.path.realpath(os.path.join(job["snapshot_dir"], name))
    if target != os.path.join(base, name) or os.path.commonpath([base, target]) != base:
        _exit_err(f"path escapes snapshot_dir: {name}")
    return target


def _run(cmd: list[str]) -> None:
    print("snap-bak-io CMD: " + " ".join(cmd), file=sys.stderr)
    try:
        subprocess.run(cmd, check=True)
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)


def _check_restic_trusted() -> None:
    """Ensure restic is a root-owned binary that no other user can replace.

    setcap is only meaningful on a binary we trust. The wrapper is the root
    boundary, so before self-updating or setting capabilities we verify:
      - the binary path is a regular file (not a symlink into a user dir)
      - its directory is root-owned and not writable by group/other
      - the binary itself is root-owned and not writable by group/other
    """
    real = os.path.realpath(RESTIC)
    for d in (os.path.dirname(real), real):
        try:
            st = os.stat(d)
        except OSError:
            _exit_err(f"restic not found at {RESTIC}", code=3)
        if st.st_uid != 0:
            _exit_err(f"{d} is not owned by root", code=3)
        if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            _exit_err(f"{d} is writable by group/other (mode {oct(st.st_mode & 0o777)})", code=3)
    if os.path.islink(RESTIC):
        _exit_err(f"{RESTIC} must not be a symlink (setcap needs the real file)", code=3)


def _setcap() -> None:
    _run([SETCAP, "cap_dac_read_search=+ep", RESTIC])


def _update_restic() -> None:
    """Self-update restic (as root) then (re)apply cap_dac_read_search.

    restic self-update replaces the binary and thereby drops any setcap xattrs
    it had; re-applying setcap here (idempotent, even when already newest) is
    what makes every update safe. Exit codes: 0 = ok, 2 = self-update failed
    but existing restic retained and setcap applied, 3 = binary missing/
    unusable/untrusted, 4 = setcap failed (backups would fail to read
    root-owned files).
    """
    _check_restic_trusted()
    try:
        _run([RESTIC, "self-update"])
    except SystemExit as e:
        # self-update failed (e.g. no network). The old binary is retained
        # and remains usable; still (re)apply setcap for the retained binary.
        update_failed = e.code
        _check_restic_trusted()
        try:
            _setcap()
        except SystemExit as se:
            _exit_err(
                f"setcap failed (rc={se.code}): restic retained but cannot read "
                f"root-owned snapshot files",
                code=4,
            )
        _exit_err(
            f"restic self-update failed (rc={update_failed}); "
            f"existing restic retained and setcap applied",
            code=2,
        )
    _check_restic_trusted()
    try:
        _setcap()
    except SystemExit as e:
        _exit_err(
            f"setcap failed (rc={e.code}): restic updated but cannot read "
            f"root-owned snapshot files",
            code=4,
        )


def main() -> None:
    if len(sys.argv) < 2:
        _exit_err(
            "usage: snap-bak-io <snapshot|delete|mount|umount|update-restic> "
            "<job> [name]"
        )
    op = sys.argv[1]

    if op == "update-restic":
        _update_restic()
        return

    if len(sys.argv) < 3:
        _exit_err(f"{op} requires: <job> [name]")
    job_name = sys.argv[2]
    config = load_config()
    job = _find_job(config, job_name)

    if op == "snapshot":
        if len(sys.argv) != 4:
            _exit_err("snapshot requires: <job> <name>")
        name = _validate_name(sys.argv[3])
        target = _job_path(job, name)
        _run([BTRFS, "subvolume", "snapshot", "-r", job["source_subvolume"], target])

    elif op == "delete":
        if len(sys.argv) != 4:
            _exit_err("delete requires: <job> <name>")
        name = _validate_name(sys.argv[3])
        target = _job_path(job, name)
        _run([BTRFS, "subvolume", "delete", target])

    elif op == "mount":
        if len(sys.argv) != 4:
            _exit_err("mount requires: <job> <name>")
        name = _validate_name(sys.argv[3])
        snap_path = _job_path(job, name)
        mount_point = _job_mount_point(config, job)
        os.makedirs(mount_point, exist_ok=True)
        # btrfs has no uid/gid mount options; snapshots are bound read-only so
        # the mount point is stable across backups (restic change-tracking
        # keys on the source path). restic reads root-owned files via
        # cap_dac_read_search (applied by 'update-restic').
        _run([MOUNT, "-o", "bind,ro", snap_path, mount_point])

    elif op == "umount":
        mount_point = _job_mount_point(config, job)
        _run([UMOUNT, "-l", mount_point])

    else:
        _exit_err(f"unknown operation: {op}")


if __name__ == "__main__":
    main()
